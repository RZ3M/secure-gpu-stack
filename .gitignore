# Rendered cloud-init files have a real SSH public key filled in
my-cloud-init*.yaml

# Output from running look-around.sh; regenerate instead of committing
*-results.txt

# Secrets: API keys belong in environment variables, never in the repo
.env
.env.*
*.pem
id_*

# Local tool settings
.claude/settings.local.json
.DS_Store

# Build output and noisy test-run logs
dist/
tests/results/*.log

# The videos: build files and rendered videos (regenerate with video/render.mjs)
video/build/
video/out/*.mp4
video/m2/build/
video/m2/out/*.mp4

# Python bytecode
__pycache__/
*.pyc

# The M2 test bench keeps its VM disks, the cloud image and the VMs' SSH key
# next to its scripts (tests/gpu-vm/vm.sh).
tests/gpu-vm/*
!tests/gpu-vm/*.sh
