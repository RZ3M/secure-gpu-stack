# Rendered cloud-init files have a real SSH public key filled in
my-cloud-init*.yaml

# Output from running look-around.sh; regenerate instead of committing
*-results.txt

# Secrets: API keys belong in environment variables, never in the repo
.env
.env.*
*.pem
id_*

# Local tool settings
.claude/settings.local.json
.DS_Store

# Build output and noisy test-run logs
dist/
tests/results/*.log

# The walkthrough video: build files and rendered videos (regenerate with video/render.mjs)
video/build/
video/out/*.mp4

# Python bytecode
__pycache__/
*.pyc
