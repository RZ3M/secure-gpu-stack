#!/usr/bin/env python3
"""sgs-sbom: list every software component on this machine, as CycloneDX JSON.

    sgs-sbom [--output FILE]

Covers the apt packages (from dpkg) and the Secure GPU Stack's Python
environments (/opt/sgs/venv, /opt/sgs/tools, /opt/sgs/tf-cuda12), with each
wheel's RECORD hash, so the list describes what is actually installed, not
what a lockfile asked for. On a machine without the stack, it covers the OS's
own Python packages instead, so Lambda Stack can be described the same way.

It only reads package metadata. It never imports or runs the packages it lists.
"""
import argparse
import datetime
import glob
import hashlib
import json
import os
import platform
import stat
import subprocess
import sys
import tempfile
import uuid
from urllib.parse import quote

SITES = [
    ("venv", "/opt/sgs/venv/lib/python3*/site-packages"),
    ("tools", "/opt/sgs/tools/lib/python3*/site-packages"),
    ("tf-cuda12", "/opt/sgs/tf-cuda12"),
]


def deb_components():
    out = subprocess.run(
        ["dpkg-query", "-W", "-f", "${db:Status-Abbrev}\t${Package}\t${Version}\t${Architecture}\t${Maintainer}\n"],
        capture_output=True, text=True, check=True).stdout
    distro = "ubuntu"
    for line in out.splitlines():
        status, name, version, arch, maintainer = (line.split("\t") + [""] * 5)[:5]
        # The second letter is the actual state: "hi" (held) is installed too.
        if status[1:2] != "i":
            continue
        yield {
            "type": "library" if name.startswith("lib") else "application",
            "name": name,
            "version": version,
            "purl": f"pkg:deb/{distro}/{quote(name, safe='')}@{quote(version, safe='')}?arch={quote(arch, safe='')}",
            "supplier": {"name": maintainer} if maintainer else None,
            "properties": [{"name": "sgs:source", "value": "dpkg"}],
        }


def read_regular(path, limit):
    # This runs as root over files a package put there: only regular files, no
    # symlinks (O_NOFOLLOW), and never more than `limit` bytes, so a planted
    # FIFO, device or link can't hang it or make it read something else.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(f"not a regular file: {path}")
        return os.read(fd, limit)
    finally:
        os.close(fd)


def dist_name_version(dist_info):
    # Wheels write .dist-info/METADATA; Debian-packaged Python (Lambda Stack's
    # torch and keras) often has the older .egg-info, a folder or a single file.
    if os.path.isdir(dist_info) and not os.path.islink(dist_info):
        meta = os.path.join(dist_info, "METADATA" if dist_info.endswith(".dist-info") else "PKG-INFO")
    else:
        meta = dist_info
    name = version = None
    text = read_regular(meta, 1 << 20).decode(errors="replace")
    for line in text.splitlines():
        if line.startswith("Name:") and name is None:
            name = line.split(":", 1)[1].strip()
        elif line.startswith("Version:") and version is None:
            version = line.split(":", 1)[1].strip()
        elif not line.strip():
            break
    return name, version


def record_digest(dist_info):
    # A hash of the wheel's RECORD file, which lists a hash for every file the
    # wheel installed. It identifies that exact build, but it does NOT change
    # when an installed file is edited afterwards: sgs-check's file integrity
    # check verifies each file against RECORD.
    path = os.path.join(dist_info, "RECORD")
    try:
        return hashlib.sha256(read_regular(path, 64 << 20)).hexdigest()
    except OSError:
        return None


def python_components():
    sites = [(env, p) for env, pattern in SITES for p in glob.glob(pattern)]
    if not sites:
        sites = [("system", p) for p in ("/usr/lib/python3/dist-packages",) if os.path.isdir(p)]
    for env, site in sites:
        for dist_info in sorted(glob.glob(os.path.join(site, "*.dist-info")) + glob.glob(os.path.join(site, "*.egg-info"))):
            try:
                name, version = dist_name_version(dist_info)
            except OSError:
                continue
            if not name:
                continue
            # Name and version come from the package itself, so they're
            # percent-encoded: a crafted name can't forge another package's purl.
            comp = {
                "type": "library",
                "name": name,
                "version": version,
                "purl": f"pkg:pypi/{quote(name.lower().replace('_', '-'), safe='')}@{quote(version or '', safe='')}",
                "properties": [{"name": "sgs:environment", "value": env},
                               {"name": "sgs:location", "value": site},
                               {"name": "sgs:metadata", "value": os.path.basename(dist_info)}],
            }
            digest = record_digest(dist_info)
            if digest:
                comp["hashes"] = [{"alg": "SHA-256", "content": digest}]
                comp["properties"].append({"name": "sgs:hash-of", "value": "the wheel's RECORD file (identifies the build; edits to installed files are caught by sgs-check)"})
            yield comp


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--output", "-o", help="write to FILE instead of standard output")
    args = ap.parse_args()

    components, refs = [], set()
    for comp in list(deb_components()) + list(python_components()):
        comp = {k: v for k, v in comp.items() if v is not None}
        props = {p["name"]: p["value"] for p in comp["properties"]}
        # Unique even when a package has both a .dist-info and an .egg-info.
        ref = comp["purl"] + "#" + props.get("sgs:environment", "deb") + "/" + props.get("sgs:metadata", "dpkg")
        if ref in refs:
            continue
        refs.add(ref)
        comp["bom-ref"] = ref
        components.append(comp)

    stack = "none detected"
    if os.path.exists("/opt/sgs/manifest.txt"):
        with open("/opt/sgs/manifest.txt") as f:
            stack = "Secure GPU Stack " + next((l.split("=", 1)[1].strip() for l in f if l.startswith("version=")), "?")
    elif subprocess.run(["dpkg-query", "-W", "lambda-repository"], capture_output=True).returncode == 0:
        stack = "Lambda Stack"

    bom = {
        "bomFormat": "CycloneDX",
        "specVersion": "1.5",
        "serialNumber": f"urn:uuid:{uuid.uuid4()}",
        "version": 1,
        "metadata": {
            "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "tools": [{"name": "sgs-sbom"}],
            "component": {"type": "operating-system", "name": platform.node() or "host",
                          "version": platform.release(),
                          "properties": [{"name": "sgs:stack", "value": stack}]},
        },
        "components": components,
    }
    text = json.dumps(bom, indent=1)
    if args.output:
        # Write a new file next to the target and rename it into place: run as
        # root, opening the target directly would follow a symlink someone
        # planted there (into /etc/shadow, say).
        out_dir = os.path.dirname(os.path.abspath(args.output))
        fd, tmp = tempfile.mkstemp(dir=out_dir, prefix=".sgs-sbom-")
        try:
            with os.fdopen(fd, "w") as f:
                f.write(text + "\n")
            os.chmod(tmp, 0o644)
            os.replace(tmp, args.output)
        except BaseException:
            os.unlink(tmp)
            raise
        debs = sum(1 for c in components if c["purl"].startswith("pkg:deb/"))
        print(f"{len(components)} components ({debs} apt, {len(components) - debs} Python) -> {args.output}",
              file=sys.stderr)
    else:
        print(text)


if __name__ == "__main__":
    main()
